{
  "name": "@codever/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Codever local gateway for remotely managed ACP coding agents",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codever": "./bin/codever.js",
    "codever-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:business-e2e": "pnpm test:e2e && pnpm --filter @codever/web typecheck && pnpm --filter @codever/web test && pnpm --filter @codever/web exec playwright test",
    "test:release-e2e": "pnpm test:business-e2e && pnpm test:desktop-e2e",
    "test:desktop-e2e": "pnpm --filter @codever/web test:desktop:e2e",
    "build:all": "pnpm -r --if-present build",
    "typecheck:all": "pnpm -r --if-present typecheck",
    "test:all": "pnpm -r --if-present test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codever/execution-auth": "workspace:*",
    "@codever/protocol": "workspace:*",
    "@agentclientprotocol/sdk": "^0.19.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.4.3",
    "@tencent-ai/agent-sdk": "^0.3.121",
    "chalk": "^5.3.0",
    "conf": "^12.0.0",
    "grammy": "^1.30.0",
    "https-proxy-agent": "^9.0.0",
    "undici": "^8.7.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/ws": "^8.18.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
