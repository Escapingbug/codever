{
  "name": "@codever/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "tauri": "pnpm dlx @tauri-apps/cli@2.11.4",
    "desktop:dev": "pnpm dlx @tauri-apps/cli@2.11.4 dev",
    "desktop:build": "pnpm dlx @tauri-apps/cli@2.11.4 build",
    "android:init": "pnpm dlx @tauri-apps/cli@2.11.4 android init",
    "android:dev": "pnpm dlx @tauri-apps/cli@2.11.4 android dev",
    "ios:init": "pnpm dlx @tauri-apps/cli@2.11.4 ios init",
    "ios:dev": "pnpm dlx @tauri-apps/cli@2.11.4 ios dev"
  },
  "dependencies": {
    "@codever/protocol": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.0.0"
  }
