<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        This manifest belongs only to the separately installed .e2e package.
        Its native bridge still accepts exactly the loopback origin compiled
        into BuildConfig, while cleartext lets the emulator reach disposable
        local PWA and Synapse fixtures through adb reverse.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_e2e"
        android:usesCleartextTraffic="true"
        tools:replace="android:networkSecurityConfig,android:usesCleartextTraffic">

        <!--
            Test-only upgrade fixture. The Alpha journey invokes this receiver
            explicitly while the app is stopped so it can cover-install a new
            APK over a real encrypted legacy command outbox. It is absent from
            every production build variant.
        -->
        <receiver
            android:name="id.my.anciety.codever.e2e.LegacyOutboxSeederReceiver"
            android:exported="true" />
    </application>

</manifest>
